# Microsoft Dynamics 365 & Azure App Registration
CRM_URL=https://yourorg.crm.dynamics.com
TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-azure-client-id
CLIENT_SECRET=your-azure-client-secret

# Google Gemini / OpenAI API Key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Server Port
PORT=3000

# Cloudflare Tunnel Public URLs
CLOUDFLARE_URL=https://your-tunnel-name.trycloudflare.com
SALES_AGENT_URL=https://your-tunnel-name.trycloudflare.com/widget
INVOICE_AGENT_URL=https://your-tunnel-name.trycloudflare.com/invoice
